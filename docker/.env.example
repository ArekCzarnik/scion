# Optional overrides for docker/compose.yml. Copy to docker/.env; every value has a default.

# Address and port published on the host. Keep 127.0.0.1 unless clients connect from elsewhere.
#SCION_BIND=127.0.0.1
#SCION_PORT=7443

# Names and IPs in the TLS certificate. Add the name clients use when SCION_BIND is not local.
#SCION_TLS_HOSTS=localhost,127.0.0.1,scion-server

# MinIO credentials, read on the first start of its volume. The minimum secret length is 8.
#SCION_S3_ACCESS_KEY=scion
#SCION_S3_SECRET_KEY=scion-local-only

# GitHub OAuth App client id with device flow enabled; empty disables `scion login` for people.
#SCION_GITHUB_CLIENT_ID=
